# Official TypeSafe key. The Python SDK reads TYPESAFE_API_KEY.
# Create one in the TypeSafe console. Do not commit the real value.
TYPESAFE_API_KEY=
# Documented model id. jev-latest tracks the current Jev release.
# Pin jev-1.13.0 if you need a fixed decision threshold.
TYPESAFE_DEFAULT_MODEL=jev-latest

# Jev accepts text only and does not write brochure copy.
# Optional OpenAI-compatible chat endpoint for headlines and body text.
# Leave COPY_MODEL empty to use source sentences only.
COPY_API_KEY=
COPY_API_BASE=https://api.openai.com/v1
COPY_MODEL=

# Optional vision model. It describes screenshots; Jev still chooses actions.
# Use an OpenAI-compatible chat model that accepts image inputs.
VISION_API_KEY=
VISION_API_BASE=https://api.openai.com/v1
VISION_MODEL=

# Starting thresholds. Tune them on your own runs.
BROCHURE_MAX_ACTIONS=60
BROCHURE_RETRY_LIMIT=2
BROCHURE_SETTLE_SECONDS=0.6
